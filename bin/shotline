#!/bin/bash
#
# shotline -- collect commented screenshots, one step at a time.
#
# A session gathers screenshots in a working directory. Every shot gets its
# comment right away. At the end you pick a target directory; the PNGs move
# there together with session.html (to look at) and session.md (for the AI
# agent). The matching agent prompt ends up in the clipboard.
#
#   shotline shot          capture a screenshot and comment on it
#   shotline finish        close the session and file it away
#   shotline status --json state, for the bar widget
#
# All state lives under $XDG_STATE_HOME/shotline.

set -uo pipefail

VERSION="1.0.0"
PLUGIN_ID="io.github.olivgrau.shotline"
SCHEMA=1

STATE_DIR="${SHOTLINE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/shotline}"
SESSIONS_DIR="$STATE_DIR/sessions"
CURRENT_FILE="$STATE_DIR/current"
RECENT_FILE="$STATE_DIR/recent-targets"
LAST_RESULT_FILE="$STATE_DIR/last-result"
RECENT_MAX=8

# The same paths omarchy-capture-region uses: the key bindings on slurp's
# selection layer write there, no matter who started slurp.
# XDG_RUNTIME_DIR belongs to this user and is mode 700. Never fall back to
# /tmp: there any local process could plant a marker, and a selection the user
# cancelled would turn into a capture of the whole screen.
MARKER_DIR="${XDG_RUNTIME_DIR:-$STATE_DIR}"
FULLSCREEN_MARKER="$MARKER_DIR/omarchy-capture-region-fullscreen"
WINDOW_MARKER="$MARKER_DIR/omarchy-capture-region-window"

SELF_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RENDERER="${SHOTLINE_RENDERER:-$SELF_DIR/shotline-render}"
PYTHON="${SHOTLINE_PYTHON:-python}"

# ------------------------------------------------------------------ helpers

die() {
  echo "shotline: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is missing. Please install it."
}

notify() {
  # For scripts and screen recordings: SHOTLINE_QUIET=1 mutes every message.
  [[ -n ${SHOTLINE_QUIET:-} ]] && return 0
  local title="$1" body="${2:-}"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "$title" ${body:+"$body"} -t 2500 >/dev/null 2>&1 && return 0
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 2500 "$title" "$body" >/dev/null 2>&1 && return 0
  fi
  echo "$title${body:+ -- $body}"
}

# The bar widget polls anyway, but a nudge makes the counter jump right away.
poke_widget() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  omarchy-shell "$PLUGIN_ID" refresh >/dev/null 2>&1 || true
}

now_iso() { date --iso-8601=seconds; }

# An aborted run must leave behind neither the frozen screen nor a changed
# cursor setting.
FREEZE_PID=""
RESTORE_CURSORS=""

cleanup() {
  [[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" 2>/dev/null
  [[ -n $RESTORE_CURSORS ]] && hyprctl keyword cursor:no_hardware_cursors "$RESTORE_CURSORS" >/dev/null 2>&1
  FREEZE_PID=""
  RESTORE_CURSORS=""
  return 0
}
trap cleanup EXIT INT TERM

# Comment to file name: spell out umlauts, boil the rest down to a-z0-9-.
slugify() {
  local text="${1:-}"
  text="${text//ä/ae}"; text="${text//ö/oe}"; text="${text//ü/ue}"
  text="${text//Ä/ae}"; text="${text//Ö/oe}"; text="${text//Ü/ue}"
  text="${text//ß/ss}"
  text=$(printf '%s' "$text" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')
  text=$(printf '%s' "$text" | sed -e 's/-\+/-/g' -e 's/^-//' -e 's/-$//')
  text="${text:0:40}"
  printf '%s' "${text%-}"
}

# Width and height from a PNG's IHDR chunk. On HiDPI screens the image is
# larger than the logical selection, and the image is what the agent sees.
png_size() {
  local file="$1" signature hex
  signature=$(od -An -tx1 -N8 "$file" 2>/dev/null | tr -d ' \n')
  [[ $signature == "89504e470d0a1a0a" ]] || return 1
  hex=$(od -An -tx1 -j16 -N8 "$file" 2>/dev/null | tr -d ' \n')
  [[ ${#hex} -eq 16 ]] || return 1
  printf '%d %d' "$((16#${hex:0:8}))" "$((16#${hex:8:8}))"
}

# ------------------------------------------------------------------ dialogs

# Free text. Prefers the Omarchy menu dialog so the input appears right over
# the screen, without a terminal window.
ask_text() {
  local prompt="$1" answer
  if [[ -n ${SHOTLINE_ANSWER:-} ]]; then
    printf '%s' "$SHOTLINE_ANSWER"
    return 0
  fi
  if command -v omarchy-menu-input >/dev/null 2>&1; then
    answer=$(omarchy-menu-input "$prompt" --width 620 2>/dev/null) || return 1
    printf '%s' "$answer"
    return 0
  fi
  if command -v gum >/dev/null 2>&1 && [[ -t 0 ]]; then
    answer=$(gum input --prompt "$prompt: " --width 80) || return 1
    printf '%s' "$answer"
    return 0
  fi
  [[ -t 0 ]] || return 1
  read -r -p "$prompt: " answer || return 1
  printf '%s' "$answer"
}

# Pick one of a list. Prints the chosen line, returns 1 when cancelled.
ask_select() {
  local prompt="$1"; shift
  local options=("$@") choice index
  ((${#options[@]} > 0)) || return 1

  if [[ -n ${SHOTLINE_CHOICE:-} ]]; then
    printf '%s' "$SHOTLINE_CHOICE"
    return 0
  fi
  if command -v omarchy-menu-select >/dev/null 2>&1; then
    choice=$(printf '%s\n' "${options[@]}" | omarchy-menu-select "$prompt" -- --width 780 --maxheight 460 2>/dev/null) || return 1
    printf '%s' "$choice"
    return 0
  fi
  if command -v gum >/dev/null 2>&1 && [[ -t 0 ]]; then
    choice=$(printf '%s\n' "${options[@]}" | gum choose --header "$prompt") || return 1
    printf '%s' "$choice"
    return 0
  fi
  [[ -t 0 ]] || return 1
  echo "$prompt" >&2
  for index in "${!options[@]}"; do
    printf '  %d) %s\n' "$((index + 1))" "${options[index]}" >&2
  done
  read -r -p "Number: " index || return 1
  [[ $index =~ ^[0-9]+$ ]] && ((index >= 1 && index <= ${#options[@]})) || return 1
  printf '%s' "${options[index - 1]}"
}

# ------------------------------------------------------------------ session

session_dir() {
  [[ -s $CURRENT_FILE ]] || return 1
  local dir
  dir=$(<"$CURRENT_FILE")
  [[ -n $dir && -f $dir/session.json ]] || return 1
  printf '%s' "$dir"
}

session_count() {
  local dir="$1"
  jq -r '.shots | length' "$dir/session.json" 2>/dev/null || echo 0
}

session_title() {
  local dir="$1"
  jq -r '.title // ""' "$dir/session.json" 2>/dev/null || echo ""
}

start_session() {
  local title="${1:-}" id dir
  id=$(date +'%Y-%m-%d_%H-%M-%S')
  dir="$SESSIONS_DIR/$id"
  # Two starts in the same second get separate directories.
  local suffix=1
  while [[ -e $dir ]]; do
    dir="$SESSIONS_DIR/$id-$suffix"
    ((suffix++))
  done
  (umask 077 && mkdir -p "$dir") || die "cannot create $dir"
  jq -n --argjson schema "$SCHEMA" --arg id "$(basename "$dir")" \
    --arg title "$title" --arg created "$(now_iso)" \
    '{schema:$schema, id:$id, title:$title, created:$created, shots:[]}' \
    >"$dir/session.json" || die "cannot write session.json"
  printf '%s' "$dir" >"$CURRENT_FILE"
  printf '%s' "$dir"
}

ensure_session() {
  local dir
  if dir=$(session_dir); then
    printf '%s' "$dir"
    return 0
  fi
  start_session ""
}

# ------------------------------------------------------------------ capture

active_workspace() {
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .activeWorkspace.id'
}

# Monitors count in physical pixels and can be rotated; slurp and grim expect
# the logical geometry.
monitor_rects() {
  hyprctl monitors -j 2>/dev/null | jq -r --arg ws "$(active_workspace)" '
    .[] | select(.activeWorkspace.id == ($ws | tonumber))
    | .x as $x | .y as $y
    | (.width / .scale | floor) as $w | (.height / .scale | floor) as $h
    | if .transform == 1 or .transform == 3
      then "\($x),\($y) \($h)x\($w)"
      else "\($x),\($y) \($w)x\($h)" end'
}

window_rects() {
  hyprctl clients -j 2>/dev/null | jq -r --arg ws "$(active_workspace)" '
    [ .[] | select(.workspace.id == ($ws | tonumber) and .hidden != true)
      | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" ] | unique[]'
}

focused_monitor_geo() {
  hyprctl monitors -j 2>/dev/null | jq -r '
    .[] | select(.focused == true)
    | .x as $x | .y as $y
    | (.width / .scale | floor) as $w | (.height / .scale | floor) as $h
    | if .transform == 1 or .transform == 3
      then "\($x),\($y) \($h)x\($w)"
      else "\($x),\($y) \($w)x\($h)" end'
}

# Rectangles of every window and monitor on the active workspace. slurp uses
# them as snap targets, so a click grabs a whole window.
capture_rects() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  [[ -n $(active_workspace) ]] || return 0
  monitor_rects
  window_rects
}

# Smallest rectangle from stdin that contains the point. slurp highlights the
# smallest one too, so this resolves the same way the display does.
rect_at() {
  local x=$1 y=$2 rect best="" best_area=0 area
  while IFS= read -r rect; do
    [[ $rect =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || continue
    ((x >= BASH_REMATCH[1] && x < BASH_REMATCH[1] + BASH_REMATCH[3] &&
      y >= BASH_REMATCH[2] && y < BASH_REMATCH[2] + BASH_REMATCH[4])) || continue
    area=$((BASH_REMATCH[3] * BASH_REMATCH[4]))
    if [[ -z $best ]] || ((area < best_area)); then
      best=$rect
      best_area=$area
    fi
  done
  [[ -n $best ]] || return 1
  printf '%s' "$best"
}

# Whatever slurp highlights under the pointer. Windows win over monitors, as
# in the Omarchy picker; a pointer in a gap hits the monitor.
geo_at_cursor() {
  local pos x y
  pos=$(hyprctl cursorpos 2>/dev/null) || { focused_monitor_geo; return; }
  x=${pos%,*}
  y=${pos#*, }
  rect_at "$x" "$y" < <(window_rects) && return 0
  rect_at "$x" "$y" < <(monitor_rects) && return 0
  focused_monitor_geo
}

# Selection over a frozen screen. slurp -d shows the size of the region while
# you drag -- exactly what you want to see. Prints "X,Y WxH"; 1 when cancelled.
pick_region() {
  if [[ -n ${SHOTLINE_GEOMETRY:-} ]]; then
    printf '%s' "$SHOTLINE_GEOMETRY"
    return 0
  fi
  need slurp

  local rects selection
  if command -v hyprpicker >/dev/null 2>&1; then
    hyprpicker -r -z >/dev/null 2>&1 &
    FREEZE_PID=$!
    sleep 0.1
  fi

  # While slurp runs, Omarchy binds keys to its selection layer: Return takes
  # the highlighted window, Ctrl+Return the whole screen. Both end slurp and
  # leave nothing but a marker file, so we check for those afterwards. Tab and
  # the arrow keys only move the pointer and need nothing here.
  rm -f "$FULLSCREEN_MARKER" "$WINDOW_MARKER"

  rects=$(capture_rects)
  if [[ -n $rects ]]; then
    selection=$(printf '%s\n' "$rects" | slurp -d 2>/dev/null)
  else
    selection=$(slurp -d 2>/dev/null)
  fi

  if [[ -z $selection && -e $FULLSCREEN_MARKER ]]; then
    selection=$(focused_monitor_geo)
  elif [[ -z $selection && -e $WINDOW_MARKER ]]; then
    selection=$(geo_at_cursor)
  fi
  rm -f "$FULLSCREEN_MARKER" "$WINDOW_MARKER"

  # A bare click (area below 20 px^2) snaps to the rectangle underneath.
  if [[ $selection =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] \
     && ((BASH_REMATCH[3] * BASH_REMATCH[4] < 20)); then
    local snapped
    snapped=$(rect_at "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" <<<"$rects") && selection="$snapped"
  fi

  [[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" 2>/dev/null
  FREEZE_PID=""
  [[ -n $selection ]] || return 1
  printf '%s' "$selection"
}

# The window whose rectangle contains the centre of the selection. Prints
# "class<TAB>title", or nothing.
window_at() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  local geometry="$1"
  [[ $geometry =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 0
  local cx=$((BASH_REMATCH[1] + BASH_REMATCH[3] / 2))
  local cy=$((BASH_REMATCH[2] + BASH_REMATCH[4] / 2))

  local ws
  ws=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .activeWorkspace.id')
  [[ -n $ws ]] || return 0

  hyprctl clients -j 2>/dev/null | jq -r --argjson x "$cx" --argjson y "$cy" --arg ws "$ws" '
    [ .[] | select(.hidden != true and .workspace.id == ($ws | tonumber))
      | select($x >= .at[0] and $x < (.at[0] + .size[0]))
      | select($y >= .at[1] and $y < (.at[1] + .size[1]))
      | {c: .class, t: .title, area: (.size[0] * .size[1])} ]
    | sort_by(.area) | .[0] // empty | "\(.c)\t\(.t)"'
}

# Software cursors end up baked into grim's frames, so we force hardware
# cursors during the capture and restore the setting afterwards.
# A sleeping screen hands grim no frame at all: grim then waits forever.
# Better to wake it first and cap the wait hard.
wake_display() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  local sleeping
  sleeping=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.dpmsStatus == false)] | length')
  [[ ${sleeping:-0} -gt 0 ]] || return 0
  # Hyprland with a Lua config (Omarchy 4) no longer understands the old
  # "dispatch dpms on" short form, while older installs understand only that.
  hyprctl eval 'hl.dispatch(hl.dsp.dpms("on"))' >/dev/null 2>&1 \
    || hyprctl dispatch dpms on >/dev/null 2>&1
  sleep 0.3
}

grab() {
  local geometry="$1" target="$2" rc=0
  need grim
  wake_display
  if command -v hyprctl >/dev/null 2>&1; then
    RESTORE_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j 2>/dev/null | jq -r '.int // empty')
    [[ -n $RESTORE_CURSORS ]] && hyprctl keyword cursor:no_hardware_cursors 0 >/dev/null 2>&1
  fi

  local limit="${SHOTLINE_GRAB_TIMEOUT:-20}"
  if command -v timeout >/dev/null 2>&1; then
    timeout "$limit" grim -g "$geometry" "$target" || rc=$?
  else
    grim -g "$geometry" "$target" || rc=$?
  fi

  if [[ -n $RESTORE_CURSORS ]]; then
    hyprctl keyword cursor:no_hardware_cursors "$RESTORE_CURSORS" >/dev/null 2>&1
    RESTORE_CURSORS=""
  fi
  ((rc == 124)) && warn_slow_grab
  return $rc
}

warn_slow_grab() {
  echo "shotline: grim returned nothing after ${SHOTLINE_GRAB_TIMEOUT:-20}s." >&2
  echo "  The screen is probably asleep. Wake it and try again." >&2
}

# ------------------------------------------------------------------ commands

cmd_start() {
  local title="${1:-}" dir
  if dir=$(session_dir); then
    die "a session with $(session_count "$dir") shot(s) is already running. Use finish or cancel."
  fi
  dir=$(start_session "$title")
  notify "Screenshot session started" "Next shot: Super + Shift + K"
  poke_widget
  echo "$dir"
}

cmd_shot() {
  local comment="" have_comment=false
  while (($# > 0)); do
    case "$1" in
      --comment) shift; comment="${1:-}"; have_comment=true ;;
      --comment=*) comment="${1#--comment=}"; have_comment=true ;;
      *) die "unknown option for shot: $1" ;;
    esac
    shift
  done

  need jq
  local dir geometry width height index number file target window app title
  dir=$(ensure_session)

  geometry=$(pick_region) || { echo "Selection cancelled." >&2; return 1; }
  [[ $geometry =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] \
    || die "unexpected geometry: $geometry"
  width=${BASH_REMATCH[3]}
  height=${BASH_REMATCH[4]}

  window=$(window_at "$geometry")
  app=${window%%$'\t'*}
  title=${window#*$'\t'}
  [[ $window == "$app" ]] && title=""

  index=$(session_count "$dir")
  number=$(printf '%02d' "$((index + 1))")
  target=$(mktemp "$dir/.pending-XXXXXX.png") || die "cannot create a temporary image"
  grab "$geometry" "$target" || { rm -f "$target"; die "grim could not capture"; }

  if [[ $have_comment == false ]]; then
    # The size sits in the prompt so you see the region confirmed once more
    # while you comment on it.
    comment=$(ask_text "Shot $((index + 1)) (${width}x${height} px) -- what is happening here?") || comment=""
  fi

  file="$number-$(slugify "$comment")"
  [[ $file == "$number-" ]] && file="$number-step"
  file="$file.png"
  mv "$target" "$dir/$file" || die "could not store the image"
  # grim inherits mktemp's 0600. finish copies the file into a project folder,
  # where 0600 is too narrow, so widen it -- but only as far as the umask
  # allows. A user who works under umask 077 keeps private files.
  chmod "$(printf '%04o' "$((0666 & ~0$(umask)))")" "$dir/$file" 2>/dev/null

  local pixel_width=0 pixel_height=0 measured
  if measured=$(png_size "$dir/$file"); then
    pixel_width=${measured%% *}
    pixel_height=${measured##* }
  fi

  local tmp_json
  tmp_json=$(mktemp) || die "cannot create a temporary JSON file"
  jq --arg file "$file" --arg comment "$comment" --arg geometry "$geometry" \
     --argjson width "$width" --argjson height "$height" \
     --argjson pixelWidth "$pixel_width" --argjson pixelHeight "$pixel_height" \
     --arg taken "$(now_iso)" --arg app "$app" --arg window "$title" '
     .shots += [{
       index: (.shots | length) + 1,
       file: $file, comment: $comment, geometry: $geometry,
       width: $width, height: $height,
       pixelWidth: $pixelWidth, pixelHeight: $pixelHeight,
       taken: $taken, app: $app, window: $window
     }]' "$dir/session.json" >"$tmp_json" \
    && mv "$tmp_json" "$dir/session.json" || { rm -f "$tmp_json"; die "cannot update session.json"; }

  notify "Shot $((index + 1)) saved" "${width}x${height} px${comment:+ -- $comment}"
  poke_widget
  echo "$dir/$file"
}

# Annotating and blurring. tensaku is Omarchy's screenshot editor: it saves
# back into the same file and quits once it has. Enter saves, Escape discards.
open_editor() {
  local file="$1" tool="${2:-brush}"
  if [[ -n ${SHOTLINE_EDITOR_STUB:-} ]]; then
    "$SHOTLINE_EDITOR_STUB" "$file" "$tool"
    return $?
  fi
  local editor="${SHOTLINE_EDITOR:-tensaku}"
  command -v "$editor" >/dev/null 2>&1 || {
    echo "shotline: $editor is missing. Install tensaku or set SHOTLINE_EDITOR." >&2
    return 1
  }
  "$editor" \
    --filename "$file" \
    --output-filename "$file" \
    --initial-tool "$tool" \
    --actions-on-enter save-to-file \
    --actions-on-escape exit \
    --early-exit
}

cmd_annotate() {
  local tool="brush" index=""
  while (($# > 0)); do
    case "$1" in
      --blur) tool="blur" ;;
      --tool) shift; tool="${1:-brush}" ;;
      --tool=*) tool="${1#--tool=}" ;;
      --index) shift; index="${1:-}" ;;
      --index=*) index="${1#--index=}" ;;
      *) die "unknown option for annotate: $1" ;;
    esac
    shift
  done

  need jq
  local dir count position file old_comment comment
  dir=$(session_dir) || die "no session running."
  count=$(session_count "$dir")
  ((count > 0)) || die "the session has no shots."

  position="${index:-$count}"
  [[ $position =~ ^[0-9]+$ ]] && ((position >= 1 && position <= count)) \
    || die "there is no shot number $position."

  file=$(jq -r --argjson i "$((position - 1))" '.shots[$i].file' "$dir/session.json")
  old_comment=$(jq -r --argjson i "$((position - 1))" '.shots[$i].comment' "$dir/session.json")
  [[ -f $dir/$file ]] || die "the image file $file is missing."

  open_editor "$dir/$file" "$tool" || return 1

  # The editor may crop: the image size is measured again afterwards.
  local pixel_width=0 pixel_height=0 measured
  if measured=$(png_size "$dir/$file"); then
    pixel_width=${measured%% *}
    pixel_height=${measured##* }
  fi

  # Back into the comment. An empty entry keeps the previous text.
  comment=$(ask_text "Comment on shot $position${old_comment:+ (currently: $old_comment)}") || comment=""
  [[ -n $comment ]] || comment="$old_comment"

  local tmp_json
  tmp_json=$(mktemp)
  jq --argjson i "$((position - 1))" --arg comment "$comment" \
     --argjson pixelWidth "$pixel_width" --argjson pixelHeight "$pixel_height" '
     .shots[$i].comment = $comment
     | .shots[$i].annotated = true
     | .shots[$i].pixelWidth = $pixelWidth
     | .shots[$i].pixelHeight = $pixelHeight' "$dir/session.json" >"$tmp_json" \
    && mv "$tmp_json" "$dir/session.json" || { rm -f "$tmp_json"; die "cannot update session.json"; }

  notify "Shot $position edited" "${comment:-no comment}"
  poke_widget
  echo "$dir/$file"
}

# Small menu for the bar. Offers only what is possible right now.
cmd_menu() {
  local dir count title="" options=() choice
  if dir=$(session_dir); then
    count=$(session_count "$dir")
    title=$(session_title "$dir")
  else
    dir=""; count=0
  fi

  options+=($'\uf030\tNext shot')
  if ((count > 0)); then
    options+=($'\uf040\tAnnotate last shot')
    options+=($'\uf070\tBlur out last shot')
    options+=($'\uf0e2\tDiscard last shot')
    options+=($'\uf0c7\tFinish series')
    options+=($'\uf1f8\tDiscard series')
  fi
  [[ -s $LAST_RESULT_FILE ]] && options+=($'\uf06e\tOpen last result')

  local prompt="Shotline"
  ((count > 0)) && prompt="$prompt: $count shot(s)${title:+ -- $title}"

  choice=$(ask_select "$prompt" "${options[@]}") || return 0
  # The menu dialog returns the label without the icon.
  choice="${choice#*$'\t'}"

  case "$choice" in
    "Next shot") cmd_shot ;;
    "Annotate last shot") cmd_annotate ;;
    "Blur out last shot") cmd_annotate --blur ;;
    "Discard last shot") cmd_undo ;;
    "Finish series") cmd_finish --open ;;
    "Discard series") cmd_cancel ;;
    "Open last result") cmd_open ;;
    *) return 0 ;;
  esac
}

cmd_undo() {
  need jq
  local dir count file
  dir=$(session_dir) || die "no session running."
  count=$(session_count "$dir")
  ((count > 0)) || die "the session has no shots."

  file=$(jq -r '.shots[-1].file' "$dir/session.json")
  local tmp_json
  tmp_json=$(mktemp)
  jq '.shots |= .[0:-1]' "$dir/session.json" >"$tmp_json" && mv "$tmp_json" "$dir/session.json"
  rm -f "$dir/$file"
  notify "Shot $count removed" "$((count - 1)) left"
  poke_widget
  echo "$file removed"
}

cmd_list() {
  need jq
  local dir
  dir=$(session_dir) || die "no session running."
  jq -r '.shots[] | "\(.index)\t\(.width)x\(.height)\t\(.file)\t\(.comment)"' "$dir/session.json" \
    | awk -F '\t' 'BEGIN{printf "%-4s %-12s %-28s %s\n","NR","SIZE","FILE","COMMENT"}
                   {printf "%-4s %-12s %-28s %s\n",$1,$2,$3,$4}'
}

cmd_status() {
  local json=false dir count title
  [[ ${1:-} == "--json" ]] && json=true

  if dir=$(session_dir); then
    count=$(session_count "$dir")
    title=$(session_title "$dir")
  else
    dir=""; count=0; title=""
  fi

  if [[ $json == true ]]; then
    jq -n --arg dir "$dir" --arg title "$title" --argjson count "${count:-0}" \
      '{active: ($dir != ""), count: $count, title: $title, dir: $dir,
        canAnnotate: ($count > 0)}'
  elif [[ -n $dir ]]; then
    echo "Session running: $count shot(s) in $dir"
  else
    echo "No session running."
  fi
}

cmd_cancel() {
  local dir
  dir=$(session_dir) || die "no session running."
  local count
  count=$(session_count "$dir")
  rm -rf "$dir"
  rm -f "$CURRENT_FILE"
  notify "Session discarded" "$count shot(s) deleted"
  poke_widget
  echo "discarded: $dir"
}

# Recently used target directories, newest first, without duplicates.
remember_target() {
  local target="$1" tmp
  tmp=$(mktemp)
  {
    printf '%s\n' "$target"
    [[ -f $RECENT_FILE ]] && grep -vxF "$target" "$RECENT_FILE"
  } | head -n "$RECENT_MAX" >"$tmp"
  mv "$tmp" "$RECENT_FILE"
}

target_options() {
  local defaults=("${SHOTLINE_DEFAULT_TARGET:-}" "$HOME/Development" "$HOME/Projects" "$PWD")
  {
    [[ -f $RECENT_FILE ]] && cat "$RECENT_FILE"
    printf '%s\n' "${defaults[@]}"
  } | awk 'NF && !seen[$0]++'
}

cmd_finish() {
  local target="" title="" open_after=false
  while (($# > 0)); do
    case "$1" in
      --target) shift; target="${1:-}" ;;
      --target=*) target="${1#--target=}" ;;
      --title) shift; title="${1:-}" ;;
      --title=*) title="${1#--title=}" ;;
      --open) open_after=true ;;
      *) die "unknown option for finish: $1" ;;
    esac
    shift
  done

  need jq
  local dir count
  dir=$(session_dir) || die "no session running."
  count=$(session_count "$dir")
  ((count > 0)) || die "the session has no shots. Use cancel."

  [[ -n $title ]] || title=$(session_title "$dir")
  if [[ -z $title ]]; then
    title=$(ask_text "Title of this screenshot series") || title=""
  fi
  [[ -n $title ]] || title="Screenshots"

  if [[ -z $target ]]; then
    local options=() choice
    mapfile -t options < <(target_options)
    options+=("Type another folder...")
    choice=$(ask_select "Where should the series go? (agent directory)" "${options[@]}") \
      || die "cancelled. The session is kept."
    if [[ $choice == "Type another folder..." ]]; then
      choice=$(ask_text "Path to the target directory") || die "cancelled."
    fi
    target="$choice"
  fi

  target="${target/#\~/$HOME}"
  [[ -n $target ]] || die "no target directory."
  mkdir -p "$target" || die "cannot create $target"
  # A relative path would be worthless in the agent prompt: the agent has no
  # idea which working directory shotline ran from.
  target=$(cd "$target" && pwd) || die "cannot resolve $target"

  local slug folder result suffix
  slug=$(slugify "$title")
  folder="shotline-$(date +'%Y-%m-%d')"
  [[ -n $slug ]] && folder="$folder-$slug"
  result="$target/$folder"
  suffix=2
  while [[ -e $result ]]; do
    result="$target/$folder-$suffix"
    ((suffix++))
  done

  local tmp_json
  tmp_json=$(mktemp)
  jq --arg title "$title" '.title = $title' "$dir/session.json" >"$tmp_json" \
    && mv "$tmp_json" "$dir/session.json"

  "$PYTHON" "$RENDERER" "$dir" >/dev/null || die "rendering failed."

  # Copy first, delete the source afterwards: a failure halfway through must
  # not destroy the captures.
  mkdir -p "$result" || die "cannot create $result"
  cp -a "$dir/." "$result/" || die "could not copy to $result"
  rm -f "$result/session.json"
  rm -rf "$dir"
  rm -f "$CURRENT_FILE"
  printf '%s' "$result" >"$LAST_RESULT_FILE"
  remember_target "$target"

  local prompt noun="screenshots" there="There are"
  ((count == 1)) && { noun="screenshot"; there="There is"; }
  prompt="Take a look at $result/session.md. $there $count $noun of this app in the order \
I walked through it, each with my comment. The PNG files sit in the same folder; open them \
when a comment alone is not enough. Work through the comments as a task list, and ask \
before you guess."

  command -v wl-copy >/dev/null 2>&1 && printf '%s' "$prompt" | wl-copy 2>/dev/null
  notify "Series filed: $count shots" "$result -- prompt is in the clipboard"
  poke_widget

  echo "$result"
  echo
  echo "Prompt for the agent (already in the clipboard):"
  echo
  echo "$prompt"

  if [[ $open_after == true ]]; then
    if command -v omarchy-launch-browser >/dev/null 2>&1; then
      omarchy-launch-browser "file://$result/session.html" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$result/session.html" >/dev/null 2>&1 &
    fi
  fi
}

cmd_prompt() {
  [[ -s $LAST_RESULT_FILE ]] || die "no series finished yet."
  local result count
  result=$(<"$LAST_RESULT_FILE")
  count=$(find "$result" -maxdepth 1 -name '*.png' 2>/dev/null | wc -l)
  local noun="screenshots" there="There are"
  ((count == 1)) && { noun="screenshot"; there="There is"; }
  local prompt="Take a look at $result/session.md. $there $count $noun of this app in the \
order I walked through it, each with my comment."
  command -v wl-copy >/dev/null 2>&1 && printf '%s' "$prompt" | wl-copy 2>/dev/null
  echo "$prompt"
}

cmd_open() {
  [[ -s $LAST_RESULT_FILE ]] || die "no series finished yet."
  local result
  result=$(<"$LAST_RESULT_FILE")
  if command -v omarchy-launch-browser >/dev/null 2>&1; then
    omarchy-launch-browser "file://$result/session.html" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$result/session.html" >/dev/null 2>&1 &
  else
    echo "$result/session.html"
  fi
}

usage() {
  cat <<USAGE
shotline $VERSION -- collect commented screenshots, one step at a time

  start [title]            start a new session
  shot [--comment TEXT]    pick a region, capture it, comment on it
  annotate [--blur] [--index N]
                           annotate a shot in the editor, then update its comment
  menu                     small menu with every action
  undo                     discard the last shot
  list                     show the shots of the running session
  status [--json]          state (also used by the bar widget)
  finish [--target DIR] [--title T] [--open]
                           render the series, file it away, hand over the prompt
  cancel                   discard the running session
  prompt                   print the last series' agent prompt again
  open                     open the last series' session.html
USAGE
}

# --------------------------------------------------------------------- main

# A running session holds raw screenshots of whatever was on screen: passwords,
# tokens, private messages. The working directory stays private, whatever the
# umask says. The chmod also repairs a directory an older version left at 755.
(umask 077 && mkdir -p "$STATE_DIR" "$SESSIONS_DIR") || die "cannot create $STATE_DIR"
chmod 700 "$STATE_DIR" "$SESSIONS_DIR" 2>/dev/null

command="${1:-shot}"
(($# > 0)) && shift

case "$command" in
  start) cmd_start "$@" ;;
  shot | take) cmd_shot "$@" ;;
  annotate | mark) cmd_annotate "$@" ;;
  menu) cmd_menu "$@" ;;
  undo) cmd_undo "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  finish | done) cmd_finish "$@" ;;
  cancel | abort) cmd_cancel "$@" ;;
  prompt) cmd_prompt "$@" ;;
  open) cmd_open "$@" ;;
  version | --version) echo "$VERSION" ;;
  help | --help | -h) usage ;;
  *) usage >&2; exit 2 ;;
esac
